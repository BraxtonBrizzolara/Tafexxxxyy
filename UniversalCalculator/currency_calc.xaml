<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Calculator.BlankPage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid>
		<StackPanel>
			
		<StackPanel HorizontalAlignment="Center">
			<TextBox x:Name="input" PlaceholderText="ammount" Margin="30"></TextBox>

			<ComboBox x:Name="from" PlaceholderText="from" HorizontalAlignment="Center">
				<x:String>USD</x:String>
				<x:String>Euro</x:String>
				<x:String>British Pound</x:String>
				<x:String>Indian Rupee</x:String>
			</ComboBox>
				<ComboBox x:Name="into" PlaceholderText="into" HorizontalAlignment="Center">
				<x:String>USD</x:String>
				<x:String>Euro</x:String>
				<x:String>British Pound</x:String>
				<x:String>Indian Rupee</x:String>
			</ComboBox>
		</StackPanel>
		
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
			
		<Button x:Name="calculate" HorizontalAlignment="Center" Click="calculate_Click">
			Calculate Currency
		</Button>

		<Button x:Name="exit" HorizontalAlignment="Center"  Click="exit_Click">
			Exit
		</Button>
		</StackPanel>
		<TextBox x:Name="output" PlaceholderText="output"></TextBox>
		</StackPanel>
	</Grid>
</Page>
